# CivicAid AI Environment Configuration Template
# Server & Runtime
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=["*"]

# LLM / AI Configuration (Provider Agnostic)
# Supported providers: strands, gemini, openai, anthropic, mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.2

# Strands Agents SDK (Optional for multi-agent framework)
STRANDS_API_KEY=
STRANDS_AGENT_ID=

# Storage & Database (Defaults to local JSON / SQLite, switches to DynamoDB in AWS)
STORAGE_BACKEND=dynamodb
DATABASE_URL=sqlite:///./civicaid.db
LOCAL_DATA_DIR=./data

# AWS Cloud Deployment Settings (IAM Roles used in AWS, credentials empty locally)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DYNAMODB_TABLE_SCHEMES=CivicAid-Production-Schemes
AWS_DYNAMODB_TABLE_USERS=CivicAid-Production-Users
AWS_S3_BUCKET_DOCS=civicaid-docs-production-ap-south-1

# Frontend API URL
VITE_API_URL=https://api.civicaid.in
